{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fretline",
  "version": "0.1.0",
  "identifier": "app.fretline.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Fretline",
        "width": 980,
        "height": 760,
        "minWidth": 520,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
